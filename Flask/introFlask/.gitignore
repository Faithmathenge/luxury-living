*.db
*.sqlite3
*.sqlite3-journal

# Unit testing / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Build and distribution packaging
dist/
build/
*.egg-info/

# Operating system / IDE specific files
.DS_Store
.idea/
.vscode/
